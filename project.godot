; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Unrendered: The Scourge"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/Core/EventBus.cs"
WorldStateManager="*res://src/Managers/WorldStateManager.cs"
EntityStateManager="*res://src/Managers/EntityStateManager.cs"
RealmTransitionManager="*res://src/Managers/RealmTransitionManager.cs"
InventoryCraftingManager="*res://src/Managers/InventoryCraftingManager.cs"
ResolveManager="*res://src/Managers/ResolveManager.cs"
VitalityManager="*res://src/Managers/VitalityManager.cs"
NavigationManager="*res://src/Managers/NavigationManager.cs"
DreamRunManager="*res://src/Managers/DreamRunManager.cs"
CampManager="*res://src/Managers/CampManager.cs"
CombatManager="*res://src/Managers/CombatManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="UnrenderedTheScourge"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

