; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Unrendered: The Scourge"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene="res://scenes/Boot.tscn"

[autoload]

EventBus="*res://src/Core/EventBus.cs"
WorldStateManager="*res://src/Managers/WorldStateManager.cs"
EntityStateManager="*res://src/Managers/EntityStateManager.cs"
RealmTransitionManager="*res://src/Managers/RealmTransitionManager.cs"
InventoryCraftingManager="*res://src/Managers/InventoryCraftingManager.cs"
SanityManager="*res://src/Managers/SanityManager.cs"
NavigationManager="*res://src/Managers/NavigationManager.cs"
DreamRunManager="*res://src/Managers/DreamRunManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="UnrenderedTheScourge"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[input]

toggle_realm={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306,"pressed":false,"echo":false)
]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":false)
]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":73,"pressed":false,"echo":false)
]
}
journal={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74,"pressed":false,"echo":false)
]
}
cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305,"pressed":false,"echo":false)
]
}
debug_panel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334,"pressed":false,"echo":false)
]
}
debug_cycle_entity={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194332,"pressed":false,"echo":false)
]
}
debug_save={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194336,"pressed":false,"echo":false)
]
}
debug_load={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194340,"pressed":false,"echo":false)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
